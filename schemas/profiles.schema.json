{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/healthdatasafe/compliance-matrix/schemas/profiles.schema.json",
  "title": "Implementer profiles",
  "description": "Feature vocabulary, archetype presets and scope-applicability rules for the implementer view. Rows tag obligations with these ids via implementer[].applies_when.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "features",
    "presets",
    "scope_applicability",
    "personas"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "group": {
            "enum": [
              "population",
              "us-role",
              "residency",
              "application"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          },
          "exclusive": {
            "type": "string",
            "description": "Radio group name: at most one feature carrying the same value may be on."
          }
        }
      }
    },
    "derived": {
      "type": "array",
      "description": "Named AND/OR combinations. The only place composite logic lives, so row tags stay flat any-of lists.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "oneOf": [
          {
            "required": [
              "all"
            ]
          },
          {
            "required": [
              "any"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string"
          },
          "all": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "any": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "features"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "May be empty: an archetype that ticks nothing is a legitimate starting point."
          },
          "locked": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Options this archetype settles, on or off. They render disabled: unticking 'you keep your own copy' while the copy archetype is selected would describe something that is not that archetype. Anything not listed stays free."
          }
        }
      }
    },
    "scope_applicability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "when"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "when": {
            "$ref": "#/$defs/cond"
          }
        }
      }
    },
    "uncovered": {
      "type": "array",
      "description": "Selections this matrix does NOT cover. Surfaced as a warning so a gap in the matrix never reads as an absence of obligations.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "title",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "when": {
            "$ref": "#/$defs/cond"
          },
          "unless": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "personas": {
      "type": "object",
      "description": "Which implementer persona's obligations to show, per scope. Either a map of arrangement id to persona, or {ask: [...]} when the implementer must choose.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ask": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "default": {
            "type": "string"
          },
          "derive": {
            "type": "array",
            "description": "Ordered rules. The first whose condition holds gives the persona. If none holds the implementer holds NO role under this framework, which is a real answer and must be presentable: an app that creates, receives, maintains and transmits nothing is neither a covered entity nor a business associate.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "persona",
                "when"
              ],
              "properties": {
                "persona": {
                  "type": "string"
                },
                "when": {
                  "$ref": "#/$defs/cond"
                }
              }
            }
          }
        }
      }
    },
    "step2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areas"
      ],
      "description": "Step 2 of the selection. `areas` is one growing list of places served; adding a country is one entry. `followups` are questions that appear only when a given area is selected, so a US-specific question never shows to a European implementer.",
      "properties": {
        "areas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "options"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "hint": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "feature",
                  "label"
                ],
                "properties": {
                  "feature": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "gives": {
                    "type": "string"
                  },
                  "hint": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "followups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "when",
              "question",
              "name",
              "options"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "when": {
                "type": "string",
                "description": "Feature id that must be on for this question to appear."
              },
              "title": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "description": "Radio group name; the options are mutually exclusive."
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "feature",
                    "label"
                  ],
                  "properties": {
                    "feature": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "gives": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "cond": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "all"
          ]
        },
        {
          "required": [
            "any"
          ]
        }
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
